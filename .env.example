# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas ----
# Get the full string from Atlas > Connect > Drivers. It looks like:
# mongodb+srv://<user>:<password>@<cluster-address>/<dbName>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_ADDRESS/shopeasy?retryWrites=true&w=majority

# ---- JWT ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d
RESET_TOKEN_SECRET=change-this-too-a-different-long-random-string
RESET_TOKEN_EXPIRES_IN=15m

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Gmail (App Password, not your normal Gmail password) ----
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=ShopEasy

# ---- Google Sign-In (optional, needed only for /api/auth/google) ----
GOOGLE_CLIENT_ID=

# ---- CORS ----
# Comma-separated list of allowed origins, or * for any (fine for a
# mobile app that doesn't send an Origin header).
CORS_ORIGIN=*
